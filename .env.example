# NextLayer Studio + ISRO Racing — local development template
# Copy to .env and replace placeholders. Never commit .env or real secrets.
# Only variables actually read by your code will have an effect.

# App
APP_URL=http://localhost:8888
NEXT_PUBLIC_SITE_NAME=NextLayer Studio

# Admin authentication (required for admin dashboard)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
# Generate a fresh secret: node -e "console.log(require(\'crypto\').randomBytes(48).toString(\'hex\'))"
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET

# AI integrations (optional; only if you connect these in backend code)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
AI_MODEL=REPLACE_WITH_MODEL_NAME

# ISRO Racing admin uses the same admin variables above unless code is changed
# Registration fee/payment policy: OFFLINE IN PERSON IN PUNE AT ADMISSION.
# No online payment gateway is configured in this project.
